{
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "taskboard-api",
    "Audience": "taskboard-client",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "RefreshTokenCleanupInterval": "1.00:00:00"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "storage",
    "AzureContainerName": "attachments",
    "OrphanCleanupInterval": "06:00:00",
    "OrphanGracePeriod": "01:00:00"
  },
  "Email": {
    "Enabled": false,
    "WebAppUrl": "",
    "FromAddress": "",
    "FromName": "TaskBoard",
    "RetryDelay": "00:00:05",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "Username": "",
      "Timeout": "00:00:30"
    }
  },
  "PasswordReset": {
    "TokenLifetime": "01:00:00"
  },
  "Outbox": {
    "PollingInterval": "00:00:00.500",
    "BatchSize": 50,
    "LockDuration": "00:02:00"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
