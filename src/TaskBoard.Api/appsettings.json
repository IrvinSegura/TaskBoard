{
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "Issuer": "taskboard-api",
    "Audience": "taskboard-client",
    "SigningKey": "",
    "AccessTokenLifetime": "01:00:00"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "storage",
    "AzureContainerName": "attachments"
  },
  "Outbox": {
    "PollingInterval": "00:00:00.500",
    "BatchSize": 50
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
